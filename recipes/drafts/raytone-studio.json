{
  "schema": 1,
  "id": "raytone-studio",
  "title": "Raytone Studio: Muse Glimmer 30B and MiniMax H3",
  "description": "A chat and coding model next to a video model: Muse Glimmer 30B (NVFP4, DFlash) for agents and chat, MiniMax H3 (pruned int8, NVFP4 text encoder, 8-step turbo LoRA) for text to video with sound, both on the one unified memory pool.",
  "platforms": ["thor-t5000"],
  "requires": {"memory_gib": 100, "disk_gib": 70},
  "source": "Muse parameters from Mia's AI Lab; H3 files and graph from Comfy-Org's MiniMax H3 text-to-video template",
  "components": [
    {
      "role": "chat",
      "served_name": "muse-glimmer-30b",
      "model": {"repo": "RedHatAI/Muse-Glimmer-30B-NVFP4", "revision": "e83ead547c81973aaa09c0072c0dbc916e0d8190"},
      "draft": {"repo": "meta-models/Muse-Glimmer-30B-assistant", "revision": "e8192f3a8f617f74be2ce220360c89ef4789f39f"},
      "engine": "vllm",
      "image": "vllm/vllm-openai@sha256:8a69ffad015f138d7170c4ddc429e230a3bc1c1719f67e14324749df200a4b90",
      "args": {
        "gpu-memory-utilization": 0.42,
        "kv-cache-dtype": "fp8_e4m3",
        "max-model-len": 131072,
        "enable-auto-tool-choice": true,
        "tool-call-parser": "muse_glimmer",
        "reasoning-parser": "muse_glimmer",
        "trust-remote-code": true,
        "no-enable-flashinfer-autotune": true,
        "speculative-config": {"method": "dflash", "num_speculative_tokens": 16}
      },
      "env": {}
    },
    {
      "role": "video",
      "served_name": "minimax-h3",
      "model": {"repo": "Comfy-Org/MiniMax-H3", "revision": "bf92c4091e333e69b8ca1998e0a669f15cb0832b",
                "include": ["diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
                            "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
                            "vae/minimax_h3_video_vae_fp16.safetensors",
                            "vae/minimax_h3_audio_vae_fp32.safetensors",
                            "loras/minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors"]},
      "engine": "comfyui",
      "image": "raytone/comfyui@local",
      "args": {"gpu-only": true},
      "env": {}
    }
  ],
  "agents": {"default_model": "muse-glimmer-30b"}
}
