{
  "schema": 1,
  "id": "raytone-studio-trio",
  "title": "Raytone Studio (trio): chat, video and stills",
  "description": "Chat, video and stills on the one unified pool: Nemotron 3.5 Lightning for chat and agents, MiniMax H3 resident for text to video, and Z-Image Turbo loaded per request for text to image. Nemotron is held to one concurrent request against a 65536-token context limit rather than many short ones, which is what budgets room for the other two. Measured on the Jetson AGX Thor 2026-10-22 with all three loaded and video, image and chat run concurrently: 76 GiB system peak, 45 GiB still available, and 11.75 GiB anonymous memory plus about 28 GiB of GPU weights actually held. The 90 GiB requirement is the sum of the three caps, not a measurement: the caps bound host-RAM accounting only, while the pool ComfyUI allocates from is all 122.9 GiB, of which ComfyUI reported a minimum 2.2 GiB free during the concurrent run.",
  "platforms": [
    "thor-t5000"
  ],
  "requires": {
    "memory_gib": 90,
    "disk_gib": 80
  },
  "source": "Nemotron parameters from Mia's AI Lab on LMSYS's SGLang image; H3 files and graph from Comfy-Org's MiniMax H3 text-to-video template",
  "components": [
    {
      "role": "chat",
      "served_name": "nemotron-3.5-lightning",
      "model": {
        "repo": "nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4",
        "revision": "bee7596271d1495f6992ae224aefde4410e816b8"
      },
      "draft": {
        "repo": "nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark",
        "revision": "8a0177116d138011e63103110f136ec0ca09ebbf"
      },
      "engine": "sglang",
      "image": "lmsysorg/sglang@sha256:a04d9a1a7ffe371b05230aecab001d4ba2bfa0e5c137bc56409ecc4cbc3ac864",
      "args": {
        "mem-fraction-static": 0.25,
        "mamba-ssm-dtype": "float16",
        "cuda-graph-max-bs-decode": 4,
        "reasoning-parser": "nemotron_3",
        "tool-call-parser": "qwen3_coder",
        "speculative-algorithm": "DSPARK",
        "speculative-dspark-block-size": 3,
        "context-length": 65536,
        "max-running-requests": 1,
        "kv-cache-dtype": "fp8_e4m3"
      },
      "env": {},
      "memory_gib": 32
    },
    {
      "role": "video",
      "served_name": "minimax-h3",
      "model": {
        "repo": "Comfy-Org/MiniMax-H3",
        "revision": "bf92c4091e333e69b8ca1998e0a669f15cb0832b",
        "include": [
          "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors",
          "text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "vae/minimax_h3_video_vae_fp16.safetensors",
          "vae/minimax_h3_audio_vae_fp32.safetensors",
          "loras/minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors"
        ]
      },
      "engine": "comfyui",
      "image": "raytone/comfyui@local",
      "args": {
        "reserve-vram": 54.0,
        "disable-smart-memory": true
      },
      "env": {},
      "memory_gib": 36
    },
    {
      "role": "image",
      "served_name": "z-image-turbo",
      "model": {
        "repo": "Comfy-Org/z_image_turbo",
        "revision": "6fc90a3b1b653e935a0d175e260736de25b84df5",
        "include": [
          "diffusion_models/z_image_turbo_nvfp4.safetensors",
          "diffusion_models/z_image_turbo_int8_convrot.safetensors",
          "text_encoders/qwen_3_4b_fp4_mixed.safetensors",
          "text_encoders/qwen_3_4b_fp8_mixed.safetensors",
          "vae/ae.safetensors"
        ]
      },
      "engine": "comfyui",
      "image": "raytone/comfyui@local",
      "args": {
        "lowvram": true,
        "disable-smart-memory": true,
        "reserve-vram": 64.0
      },
      "env": {},
      "memory_gib": 22
    }
  ],
  "agents": {
    "default_model": "nemotron-3.5-lightning"
  }
}
