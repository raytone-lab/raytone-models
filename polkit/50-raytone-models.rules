// The helper runs only validated engine specs, so the local, active admin user may use it
// without a password; everyone else gets the policy's defaults (admin authentication or no).
polkit.addRule(function(action, subject) {
    if (action.id == "org.raytone.models.manage" && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
