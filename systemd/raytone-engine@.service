[Unit]
Description=Raytone Models engine instance %i
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
# the helper re-validates the registered spec and execs the confined docker run
# Never remove an existing container before the helper checks compatibility.
# Managed engines already use docker run --rm; a stale name must fail visibly.
ExecStart=/usr/lib/raytone-models/raytone-models-helper --protocol 1 --component-version 0.2.2-batch4 run %i
ExecStop=/usr/bin/docker stop --time 30 raytone-%i
ExecStopPost=/usr/lib/raytone-models/raytone-models-helper --protocol 1 --component-version 0.2.2-batch4 unregister %i
TimeoutStartSec=0
TimeoutStopSec=60
Restart=no
